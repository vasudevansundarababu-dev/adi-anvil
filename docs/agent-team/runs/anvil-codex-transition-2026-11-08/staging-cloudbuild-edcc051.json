{
  "images": [
    "${_REPO}/backend:${_TAG}",
    "${_REPO}/web:${_TAG}"
  ],
  "options": {
    "logging": "CLOUD_LOGGING_ONLY",
    "machineType": "E2_HIGHCPU_8"
  },
  "serviceAccount": "projects/adi-anvil-mvp-2026/serviceAccounts/anvil-staging-build@adi-anvil-mvp-2026.iam.gserviceaccount.com",
  "steps": [
    {
      "args": [
        "build",
        "--platform=linux/amd64",
        "--file",
        "infra/docker/backend.Dockerfile",
        "--label",
        "org.opencontainers.image.revision=${_SOURCE_SHA}",
        "--tag",
        "${_REPO}/backend:${_TAG}",
        "--label",
        "io.adi.anvil.source-archive-sha256=${_SOURCE_ARCHIVE_SHA256}",
        "--label",
        "io.adi.anvil.native-manifest-sha256=${_NATIVE_MANIFEST_SHA256}",
        "--label",
        "io.adi.anvil.context-inventory-sha256=${_CONTEXT_INVENTORY_SHA256}",
        "--label",
        "io.adi.anvil.upload-inventory-sha256=${_UPLOAD_INVENTORY_SHA256}",
        "."
      ],
      "id": "backend",
      "name": "gcr.io/cloud-builders/docker",
      "waitFor": [
        "-"
      ]
    },
    {
      "args": [
        "build",
        "--platform=linux/amd64",
        "--file",
        "infra/docker/web.Dockerfile",
        "--label",
        "org.opencontainers.image.revision=${_SOURCE_SHA}",
        "--tag",
        "${_REPO}/web:${_TAG}",
        "--label",
        "io.adi.anvil.source-archive-sha256=${_SOURCE_ARCHIVE_SHA256}",
        "--label",
        "io.adi.anvil.native-manifest-sha256=${_NATIVE_MANIFEST_SHA256}",
        "--label",
        "io.adi.anvil.context-inventory-sha256=${_CONTEXT_INVENTORY_SHA256}",
        "--label",
        "io.adi.anvil.upload-inventory-sha256=${_UPLOAD_INVENTORY_SHA256}",
        "."
      ],
      "id": "web",
      "name": "gcr.io/cloud-builders/docker",
      "waitFor": [
        "-"
      ]
    }
  ],
  "substitutions": {
