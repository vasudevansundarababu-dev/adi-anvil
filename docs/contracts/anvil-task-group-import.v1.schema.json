{
  "$defs": {
    "Environment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Version",
          "type": "string"
        },
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "enforce": {
          "default": true,
          "title": "Enforce",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "kind"
      ],
      "title": "Environment",
      "type": "object"
    },
    "FailureMode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "criterion_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Criterion Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "criterion_ids"
      ],
      "title": "FailureMode",
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
          "title": "Version",
          "type": "string"
        },
        "name": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "name"
      ],
      "title": "Project",
      "type": "object"
    },
    "TaskEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "environment_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Environment Ids",
          "type": "array"
        },
        "dimensions": {
          "additionalProperties": {
            "enum": [
              "correctness",
              "evidence",
              "constraints"
            ],
            "type": "string"
          },
          "title": "Dimensions",
          "type": "object"
        },
        "failure_modes": {
          "items": {
            "$ref": "#/$defs/FailureMode"
          },
          "maxItems": 100,
          "title": "Failure Modes",
          "type": "array"
        }
      },
      "required": [
        "path",
        "environment_ids"
      ],
      "title": "TaskEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "anvil.task-group-import.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_project": {
      "$ref": "#/$defs/Project"
    },
    "environments": {
      "items": {
        "$ref": "#/$defs/Environment"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Environments",
      "type": "array"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskEntry"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    },
    "policy_manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Manifest Path"
    }
  },
  "required": [
    "schema_version",
    "source_project",
    "environments",
    "tasks"
  ],
  "title": "ProjectImport",
  "type": "object"
}
