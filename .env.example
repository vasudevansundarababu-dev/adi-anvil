# Documentation only. Run pnpm setup:local to generate ignored .env and local identities.
# Do not copy blank placeholders over an existing installation. Never commit real secrets.
ANVIL_ENV=local
ANVIL_FIXTURE_MODE=true
ANVIL_LIVE_PROVIDERS_ENABLED=false
ANVIL_REAL_EMAIL_ENABLED=false
ANVIL_WEB_PORT=3202
ANVIL_API_PORT=8200
ANVIL_POSTGRES_PORT=5542
ANVIL_NEO4J_HTTP_PORT=7475
ANVIL_NEO4J_BOLT_PORT=7688
ANVIL_OIDC_PORT=8180
WEB_ORIGIN=http://127.0.0.1:3202

# Generated local DB/identity values belong in ignored .env or secret files.
DATABASE_URL=
MIGRATION_DATABASE_URL=
WORKER_DATABASE_URL=
ANVIL_DB_OWNER_PASSWORD=
ANVIL_DB_APP_PASSWORD=
ANVIL_DB_WORKER_PASSWORD=
OIDC_ISSUER=http://127.0.0.1:8180/realms/anvil
OIDC_CLIENT_ID=anvil-web
OIDC_CLIENT_SECRET=
ANVIL_OIDC_ADMIN_PASSWORD=
ANVIL_SESSION_KEY=
NEO4J_URI=bolt://127.0.0.1:7688
ANVIL_NEO4J_PASSWORD=
# Artifact override is server-only, constrained within this repo for restore rehearsals.
ARTIFACT_ROOT=.data/artifacts
# Checkpoints use the worker database/schema.

# Set only the provider files you actually create; empty means not configured.
# Paths resolve through a fixed server-side .secrets allowlist, never arbitrary UI input.
# Each key can be provided through its named environment variable or
# .secrets/<lowercase-variable-name>. Both at once are rejected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
META_MODEL_API_KEY=
ANVIL_COMPATIBLE_API_KEY=

# Endpoint/model/pricing/budget/approvals are validated records, not bypass flags.
# Local enable flags alone must never authorize inference or external sending.
LANGSMITH_TRACING=false
