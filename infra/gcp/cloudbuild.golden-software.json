{
  "steps": [
    {
      "id": "native-core",
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "--platform=linux/amd64",
        "--build-arg",
        "PYTHON_IMAGE=python@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4",
        "--build-arg",
        "UV_IMAGE=ghcr.io/astral-sh/uv@sha256:d46db4c7b7f2e75ff80aeef95da4c2c6ff1ad399c13ab85067db4430b7c3b9c3",
        "--build-arg",
        "UV_VERSION=0.12.19",
        "--label",
        "org.opencontainers.image.revision=${_SOURCE_COMMIT}",
        "-f",
        "infra/docker/marketing-runtime.Dockerfile",
        "-t",
        "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/task-runtime:${_RUNTIME_TAG}",
        "."
      ]
    },
    {
      "id": "installed-policy-source-check",
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "run",
        "--rm",
        "--network",
        "none",
        "--read-only",
        "--user",
        "10001:10001",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--pids-limit",
        "128",
        "--memory",
        "512m",
        "--cpus",
        "1",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,size=64m",
        "-e",
        "ANVIL_ENV=local",
        "-e",
        "WEB_ORIGIN=http://127.0.0.1:3202",
        "--entrypoint",
        "/opt/anvil-runtime/bin/python",
        "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/task-runtime:${_RUNTIME_TAG}",
        "-I",
        "-B",
        "/opt/forge-runtime-checks/native_installed.py"
      ]
    },
    {
      "id": "kyc-identity",
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "--build-arg",
        "TASK_RUNTIME_IMAGE=us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/task-runtime:${_RUNTIME_TAG}",
        "--build-arg",
        "TASK_KIND=kyc",
        "--label",
        "org.opencontainers.image.revision=${_SOURCE_COMMIT}",
        "-f",
        "infra/docker/task-runtime-identity.Dockerfile",
        "-t",
        "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/kyc-runtime:${_RUNTIME_TAG}",
        "."
      ]
    },
    {
      "id": "marketing-identity",
      "name": "gcr.io/cloud-builders/docker",
      "args": [
        "build",
        "--build-arg",
        "TASK_RUNTIME_IMAGE=us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/task-runtime:${_RUNTIME_TAG}",
        "--build-arg",
        "TASK_KIND=marketing",
        "--label",
        "org.opencontainers.image.revision=${_SOURCE_COMMIT}",
        "-f",
        "infra/docker/task-runtime-identity.Dockerfile",
        "-t",
        "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/marketing-runtime:${_RUNTIME_TAG}",
        "."
      ]
    }
  ],
  "images": [
    "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/task-runtime:${_RUNTIME_TAG}",
    "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/kyc-runtime:${_RUNTIME_TAG}",
    "us-west1-docker.pkg.dev/adi-anvil-mvp-2026/anvil-qa-v1/marketing-runtime:${_RUNTIME_TAG}"
  ],
  "options": {
    "machineType": "E2_HIGHCPU_8",
    "logging": "CLOUD_LOGGING_ONLY"
  },
  "timeout": "1800s"
}
