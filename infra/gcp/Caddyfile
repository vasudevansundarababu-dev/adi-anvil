# Host router behind the Google external Application Load Balancer, which terminates HTTPS
# with a Google-managed certificate. Only the load balancer's proxy ranges are trusted for
# X-Forwarded-* headers, so Keycloak and the API see the original https scheme and client IP.
{
	auto_https off
	servers {
		trusted_proxies static {$ANVIL_TRUSTED_PROXIES:130.211.0.0/22 35.191.0.0/16}
		client_ip_headers X-Forwarded-For
	}
}

http://{$ANVIL_WEB_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	handle /api/* {
		reverse_proxy api:8200
	}
	handle {
		reverse_proxy web:3202
	}
}

http://{$ANVIL_AUTH_HOST} {
	header Strict-Transport-Security "max-age=31536000"
	header -Server
	# Keycloak administration stays private (IAP tunnel to 127.0.0.1:8180 on the VM).
	@private path /admin /admin/* /metrics* /health*
	respond @private 404
	reverse_proxy keycloak:8080
}

# Load balancer health checks (Host is the VM address) and anything unrecognised.
:80 {
	respond /healthz "ok" 200
	respond 404
}
